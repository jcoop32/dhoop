# Copy this file to .env and fill in real values before running docker compose.
API_KEY=replace-me-with-a-strong-secret

# ClickHouse credentials — used by both the clickhouse and worker services
CLICKHOUSE_DB=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# User demographics — used by the ingest service for physiological calculations
USER_BIRTHDATE=2000-01-01   # YYYY-MM-DD — age calculated automatically each year
USER_WEIGHT_KG=75
USER_HEIGHT_CM=180
